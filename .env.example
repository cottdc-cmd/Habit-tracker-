# --- Notion (required) ---
NOTION_TOKEN=secret_xxx            # from notion.so/my-integrations
NOTION_PARENT_PAGE_ID=xxx          # page the setup script builds the databases inside
NOTION_HABITS_DB=                  # filled in after `npm run setup:notion`
NOTION_LOG_DB=
NOTION_STATS_DB=

# --- Dashboard ---
DASHBOARD_PASSCODE=pick-something  # you type this once on each device
TIMEZONE=America/New_York

# --- Oura (OAuth app from cloud.ouraring.com/oauth/applications) ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# --- Google Calendar ---
# Calendar settings -> "Secret address in iCal format". Comma-separate several calendars.
GOOGLE_CALENDAR_ICS_URLS=

# --- Apple Health webhook ---
HEALTH_WEBHOOK_KEY=long-random-string
