# --- Notion (required) ---
NOTION_TOKEN=secret_xxx            # from notion.so/my-integrations
NOTION_PARENT_PAGE_ID=xxx          # page the setup script builds the databases inside
NOTION_HABITS_DB=                  # filled in after `npm run setup:notion`
NOTION_LOG_DB=
NOTION_STATS_DB=

# --- Dashboard ---
DASHBOARD_PASSCODE=pick-something  # you type this once on each device
TIMEZONE=America/New_York

# --- Oura (OAuth app from cloud.ouraring.com/oauth/applications) ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# --- Google Calendar ---
# Calendar settings -> "Secret address in iCal format". Comma-separate several calendars.
GOOGLE_CALENDAR_ICS_URLS=

# --- Apple Health webhook ---
HEALTH_WEBHOOK_KEY=long-random-string

# --- Star chart (wall tablet) ---
STARS_PARENT_PAGE_ID=              # optional: Notion page for the star chart (defaults to NOTION_PARENT_PAGE_ID)
STARS_CHORES_DB=                   # filled in after `npm run setup:stars`
STARS_REWARDS_DB=
STARS_STORE_DB=
STARS_KIDS_DB=                     # Kids list (Name, Emoji, Simple, Order, Active). Without it there's one kid
STARS_LEDGER_DB=
KIOSK_KEY=                         # printed by setup:stars. Goes in the tablet link: /stars/?k=KIOSK_KEY
STARS_CHILD_NAME=                  # optional: shown at the top of the chart
STARS_MORNING_GOAL=                # optional: label on the morning list (default "Ready by 7:30")
NTFY_TOPIC=                        # optional: free push to your phone when a prize is ready (ntfy app)
